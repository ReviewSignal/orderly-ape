// Test component for editable list with initial simple list value
templ EditableListWithSimpleValue() {
	@list.EditableList(list.EditableListProps{
		Name:  "list-with-value",
		Value: `["item1", "item2", "item3"]`,
	}) {
		@list.ListItem(list.ListItemProps{}) {
			@input.Input(input.Props{Placeholder: "Enter value"})
		}
	}
}

// Test component for editable list with initial object list value
templ EditableListWithObjectValue() {
	@list.EditableList(list.EditableListProps{
		Name:  "list-with-objects",
		Value: `[{"name": "Alice"}, {"name": "Bob"}]`,
	}) {
		@list.ListItem(list.ListItemProps{}) {
			@input.Input(input.Props{Name: "name", Placeholder: "Enter name"})
		}
	}
}

// Test component for editable list with initial keyed object value
templ EditableListWithKeyedValue() {
	@list.EditableList(list.EditableListProps{
		Name:  "list-with-keyed",
		Value: `{"key1": {"active": true}, "key2": {"active": false}}`,
	}) {
		@list.ListItem(list.ListItemProps{}) {
			@input.Input(input.Props{Placeholder: "Enter key"})
			<div class="flex items-center gap-2">
				@checkbox.Checkbox(checkbox.Props{
					Name:  "active",
					Value: "true",
				})
				@label.Label(label.Props{}) {
					Active
				}
			</div>
		}
	}
}

// Test component for editable list with select inputs
templ EditableListWithSelect() {
	@list.EditableList(list.EditableListProps{
		Name: "list-with-select",
	}) {
		@list.ListItem(list.ListItemProps{}) {
			@input.Input(input.Props{Name: "name", Placeholder: "Enter name"})
			<select name="color" class="border rounded p-1">
				<option value="">Select color</option>
				<option value="red">Red</option>
				<option value="blue">Blue</option>
				<option value="green">Green</option>
			</select>
		}
	}
}

// Test component for editable list with select and initial values
templ EditableListWithSelectValue() {
	@list.EditableList(list.EditableListProps{
		Name:  "list-with-select-value",
		Value: `[{"name": "Alice", "color": "red"}, {"name": "Bob", "color": "blue"}]`,
	}) {
		@list.ListItem(list.ListItemProps{}) {
			@input.Input(input.Props{Name: "name", Placeholder: "Enter name"})
			<select name="color" class="border rounded p-1">
				<option value="">Select color</option>
				<option value="red">Red</option>
				<option value="blue">Blue</option>
				<option value="green">Green</option>
			</select>
		}
	}
}

// Test component for editable list with multi-select
templ EditableListWithMultiSelect() {
	@list.EditableList(list.EditableListProps{
		Name: "list-with-multiselect",
	}) {
		@list.ListItem(list.ListItemProps{}) {
			@input.Input(input.Props{Name: "name", Placeholder: "Enter name"})
			<select name="tags" multiple class="border rounded p-1">
				<option value="tag1">Tag 1</option>
				<option value="tag2">Tag 2</option>
				<option value="tag3">Tag 3</option>
			</select>
		}
	}
}

// Test component for editable list with multi-select and initial values
templ EditableListWithMultiSelectValue() {
	@list.EditableList(list.EditableListProps{
		Name:  "list-with-multiselect-value",
		Value: `[{"name": "Alice", "tags": ["tag1", "tag2"]}, {"name": "Bob", "tags": ["tag3"]}]`,
	}) {
		@list.ListItem(list.ListItemProps{}) {
			@input.Input(input.Props{Name: "name", Placeholder: "Enter name"})
			<select name="tags" multiple class="border rounded p-1">
				<option value="tag1">Tag 1</option>
				<option value="tag2">Tag 2</option>
				<option value="tag3">Tag 3</option>
			</select>
		}
	}
}

