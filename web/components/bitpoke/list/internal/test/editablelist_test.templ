// Test component for editable list with ReadOnly
templ EditableListReadOnly() {
	@list.EditableList(list.EditableListProps{
		Name:     "list-readonly",
		ReadOnly: true,
		Value:    `["item1", "item2"]`,
	}) {
		@list.ListItem(list.ListItemProps{}) {
			@input.Input(input.Props{Placeholder: "Enter value"})
		}
	}
}

// Test component for editable list with ReadOnly and complex data
templ EditableListReadOnlyComplex() {
	@list.EditableList(list.EditableListProps{
		Name:     "list-readonly-complex",
		ReadOnly: true,
		Value:    `[{"name": "Alice", "role": "admin"}, {"name": "Bob", "role": "user"}]`,
	}) {
		@list.ListItem(list.ListItemProps{}) {
			@input.Input(input.Props{Name: "name", Placeholder: "Enter name"})
			<select name="role" class="border rounded p-1">
				<option value="">Select role</option>
				<option value="admin">Admin</option>
				<option value="user">User</option>
			</select>
		}
	}
}
